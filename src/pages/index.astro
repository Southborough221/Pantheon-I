---
---

<main class="site">
  <section class="hero">
    <video class="heroVideo" autoplay muted loop playsinline preload="auto">
      <source src="/hero.mp4" type="video/mp4" />
    </video>

    <div class="shade"></div>

    <header class="nav">
      <div class="brand">
        <img class="logo" src="/Logo/pantheon-logo.png" alt="Pantheon-I" />
        <div class="brandLine">A Renaissance in the Art of Research</div>
      </div>

      <nav>
        <a href="#story">Story</a>
        <a href="#society">Society</a>
        <a href="#solutions">Solutions</a>
        <a href="#signal">Signal</a>
      </nav>
    </header>

    <div class="heroText">
      <p class="heroBrand">Pantheon-I:</p>

      <h1>
        Be Anything<br />
        But Average
      </h1>

      <p class="positioning">
        High Frequency Asymmetric Research and Intelligence,<br />
        Exclusively Accessing Those Shaping<br />
        Culture, Markets, Capital &amp; Taste
      </p>
    </div>
  </section>

  <section id="story" class="story">
    <header class="storyNav">
      <div class="storyTitleMark">01</div>
      <h2>Story</h2>
    </header>

    <div class="storyIntro">
      <p>
        Since its beginning, research has lived with an uncomfortable truth.
      </p>

      <p>
        A truth once inconvenient is now - in the era of AI - an existential threat to those that ignore it.
      </p>
    </div>

    <div class="storyFilmWrap">
      <video class="storyFilm" controls playsinline preload="metadata">
        <source src="/hero.mp4" type="video/mp4" />
      </video>
    </div>
  </section>
  <section id="society" class="society">
  <header class="societyNav">
    <div class="societyTitleMark">02</div>
    <h2>Society</h2>
  </header>

  <div class="societyThesis">
    <p class="societyKicker">The Only Agentic by Design Society</p>
    <p class="societySubhead">
      Accessing those that shape markets, capital, taste and culture.
    </p>
  </div>

  <div class="societyStage">
    <div class="societyCopy">
      <p>
        Connected to deliver consensus and conflict. Pantheon-I's proprietary
        agentic persistency allows for prediction and prescription of consumer
        and category behaviours, economic, societal, geopolitical and cultural
        shifts.
      </p>
    </div>

    <div class="networkWrap">
      <svg class="network" viewBox="0 0 980 620" role="img" aria-label="Pantheon-I agentic society network">
        <defs>
          <radialGradient id="societyAura" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#c9a84c" stop-opacity=".2" />
            <stop offset="55%" stop-color="#ffd3db" stop-opacity=".08" />
            <stop offset="100%" stop-color="#06100f" stop-opacity="0" />
          </radialGradient>
        </defs>

        <circle class="networkAura" cx="490" cy="310" r="260" />

        <g class="networkLines">
          <path id="sPath1" d="M490 62 L665 98 L820 212 L850 362 L735 500 L560 555 L365 540 L185 425 L145 265 L290 115 L490 62" />
          <path id="sPath2" d="M490 62 L820 212 L735 500 L365 540 L145 265 L490 62" />
          <path id="sPath3" d="M290 115 L665 98 L850 362 L560 555 L185 425 L290 115" />
          <path id="sPath4" d="M365 205 L610 202 L720 315 L615 425 L380 430 L260 315 L365 205" />
          <path id="sPath5" d="M365 205 L615 425" />
          <path id="sPath6" d="M610 202 L380 430" />
          <path id="sPath7" d="M260 315 L720 315" />
          <path id="sPath8" d="M290 115 L490 62" />
          <path id="sPath9" d="M185 425 L820 212" />
          <path id="sPath10" d="M365 540 L665 98" />
        </g>

        <g class="dataPackets">
          <circle r="3.6"><animateMotion dur="6s" repeatCount="indefinite"><mpath href="#sPath2" /></animateMotion></circle>
          <circle r="3.2"><animateMotion dur="5s" begin="1s" repeatCount="indefinite"><mpath href="#sPath4" /></animateMotion></circle>
          <circle r="3"><animateMotion dur="7s" begin="2s" repeatCount="indefinite"><mpath href="#sPath7" /></animateMotion></circle>
          <circle r="3.2"><animateMotion dur="6.5s" begin="3s" repeatCount="indefinite"><mpath href="#sPath10" /></animateMotion></circle>
        </g>

        <g class="nodes">
          <circle cx="490" cy="62" r="6" />
          <circle cx="665" cy="98" r="6" />
          <circle cx="820" cy="212" r="6" />
          <circle cx="850" cy="362" r="6" />
          <circle cx="735" cy="500" r="6" />
          <circle cx="560" cy="555" r="6" />
          <circle cx="365" cy="540" r="6" />
          <circle cx="185" cy="425" r="6" />
          <circle cx="145" cy="265" r="6" />
          <circle cx="290" cy="115" r="6" />
          <circle cx="365" cy="205" r="5" />
          <circle cx="610" cy="202" r="5" />
          <circle cx="720" cy="315" r="5" />
          <circle cx="615" cy="425" r="5" />
          <circle cx="380" cy="430" r="5" />
          <circle cx="260" cy="315" r="5" />
        </g>

        <g class="centreText">
          <text x="490" y="260" text-anchor="middle" class="networkCentre large">+60,000</text>
          <text x="490" y="305" text-anchor="middle" class="networkCentre">Persistent Agentic</text>
          <text x="490" y="345" text-anchor="middle" class="networkCentre">Globally Influential</text>
          <text x="490" y="385" text-anchor="middle" class="networkCentre">and Elite Society</text>
        </g>

        <text x="490" y="34" text-anchor="middle" class="networkLabel">ESG</text>
        <text x="665" y="68" text-anchor="middle" class="networkLabel">UHNWI &amp; HNWI</text>
        <text x="845" y="182" text-anchor="start" class="networkLabel">Industry Luminaries</text>
        <text x="875" y="305" text-anchor="start" class="networkLabel">Luxury / Fashion Trends</text>
        <text x="875" y="382" text-anchor="start" class="networkLabel">Commerce Trends</text>
        <text x="745" y="535" text-anchor="middle" class="networkLabel">Cultural Effect</text>
        <text x="560" y="594" text-anchor="middle" class="networkLabel">Economic Effect</text>
        <text x="365" y="582" text-anchor="middle" class="networkLabel">Demographic</text>
        <text x="185" y="465" text-anchor="middle" class="networkLabel">Real Estate Impact</text>
        <text x="105" y="285" text-anchor="end" class="networkLabel">Business Impact</text>
        <text x="290" y="82" text-anchor="middle" class="networkLabel">Travel</text>
        <text x="360" y="186" text-anchor="middle" class="networkLabel">+70 Attributes Per Agent</text>
        <text x="620" y="182" text-anchor="middle" class="networkLabel">Permanent Agents</text>
        <text x="738" y="318" text-anchor="start" class="networkLabel">Societal Effect</text>
        <text x="615" y="454" text-anchor="middle" class="networkLabel">Political / Regulatory Effect</text>
        <text x="380" y="458" text-anchor="middle" class="networkLabel">Psychographic</text>
        <text x="155" y="182" text-anchor="end" class="networkLabel"> Wealth GBP200,000 to Billionaire
</text>
      </svg>
    </div>
  </div>

  <div class="societyBottomStatement">
    WE DON'T STUDY THE WORLD.

    WE ACCESS THOSE WHO SHAPE IT.
  </div>
</section>
<section id="solutions" class="solutions">
  <header class="solutionsNav">
    <div class="solutionsTitleMark">03</div>
    <h2>Solutions</h2>
  </header>

  <div class="solutionsIntro">
    <p class="solutionsKicker">Pantheon-I's 6P Research Infrastructure</p>
    <p class="solutionsSubhead">P-I generates research-grade outputs in minutes, not months.</p>
  </div>

  <div class="sixPSystem">
  <div class="sixPTop">
    <article class="pModule">
      <span>01</span>
      <h3>Provenance</h3>
      <p>Real world signals / Meta LLM Loop</p>
    </article>

    <article class="pModule">
      <span>02</span>
      <h3>P-I Synthesis</h3>
      <p>Pantheon-I proprietary synthesis</p>
    </article>

    <article class="pModule">
      <span>03</span>
      <h3>Prediction</h3>
      <p>P-I rapid predictive simulations</p>
    </article>

    <article class="pModule">
      <span>04</span>
      <h3>POV</h3>
      <p>Proprietary persistant agentic perspective and prediction</p>
    </article>

    <article class="pModule">
      <span>05</span>
      <h3>Prescription</h3>
      <p>Rapid required actions to capitalise on prediction</p>
    </article>

    <article class="pModule">
      <span>06</span>
      <h3>Performance</h3>
      <p>Business / brand outcomes</p>
    </article>
  </div>

  <div class="connectorLayer">
    <div class="returnConnector"></div>
    <div class="downConnector predictionConnector"></div>
    <div class="downConnector povConnector"></div>
    <div class="downConnector prescriptionConnector"></div>
    <div class="downConnector performanceConnector"></div>
  </div>

  <div class="compoundLayer">
    <div class="compoundLabel">Compound Learning Layer</div>
  </div>
</div>
   
  <p class="solutionsBridge">
  Pantheon-I Solutions Built on the 6P Infrastructure and the Agentic Presistant Society of the Globally Influential & Elite
  <span class="bridgeArrow">&#8595;</span>
</p>

  <div class="solutionsGrid">
    <article>
      <h3>1st Principles Rapid Consultancy</h3>
      <p>Predictive, consultancy-grade insights powered by +60,000+ agentic advisors and analysts and millions of simulations delivered in hours, not months</p>
    </article>

    <article>
      <h3>24-Hour Custom Survey</h3>
      <p>Custom surveys delivered in hours, not days, with objective outputs & near-zero marginal cost, so questions are only limited by imagination, not budget.</p>
    </article>

    <article>
      <h3>Real-Time Brand Tracking</h3>
      <p>Real-time panels from a +60,000-strong agentic society track elite and influential brand metrics weekly modelled against fast-moving data such as sales.</p>
    </article>

    <article>
      <h3>Trend Reporting &amp; Prediction</h3>
      <p>Our agentic society identifies emerging demand signals, sentiment shifts and behavioural trends, so that you can hedge on the next big or little thing</p>
    </article>

    <article>
      <h3>Content. Creative &amp; Concept Testing</h3>
      <p>Access the globally
       most influential tastemakers, design leaders & elite ahead of launch, so you know what your clientele will love before you go live.</p>
    </article>

    <article>
      <h3>LLM Agentic Strategy &amp; Optimisation</h3>
      <p>Using our agentic society and Meta LLM loop model, we deliver AEO and GEO visibility/monitoring, strategy and operations—to solve #1 LLM issue - circular optimisation.</p>
    </article>
  </div>
</section>
<section id="signal" class="signal">
  <video class="signalVideo" autoplay muted loop playsinline preload="auto">
    <source src="/hero.mp4" type="video/mp4" />
  </video>

  <div class="signalOverlay"></div>

  <header class="signalNav">
    <div class="signalTitleMark">04</div>
    <h2>Signal</h2>
  </header>

  <div class="signalStatement">
  <p class="signalLine">
    Be Anything But Average...
  </p>

  <p class="signalSubline">
  Send Us A Signal If You'd Like To Join Our Renaissance in the Art of Research
</p>
</div>
  

    <form
      class="signalForm"
      action="https://formsubmit.co/danielchapman221@gmail.com"
      method="POST"
    >
      <input type="hidden" name="_subject" value="Pantheon-I Signal" />
      <input type="hidden" name="_captcha" value="false" />

      <label>
        Name
        <input type="text" name="name" />
      </label>

      <label>
        Email address
        <input type="email" name="email" />
      </label>

      <label>
        Message
        <textarea name="message"></textarea>
      </label>

      <button type="submit">Send Signal</button>
    </form>
  </div>
</section>
</main>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500&display=swap');

  :global(body) {
    margin: 0;
    background: #0a0a0a;
    color: #ffffff;
    font-family: Arial, sans-serif;
  }

  .site {
    min-height: 100vh;
    background: #0a0a0a;
  }

  .hero {
    min-height: 100vh;
    position: relative;
    overflow: hidden;
    background: #0a0a0a;
  }

  .heroVideo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.80;
  }

  .shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(10,10,10,.12), rgba(10,10,10,.58)),
      radial-gradient(circle at center, rgba(0,0,0,.02), rgba(0,0,0,.42));
  }

  .nav {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 26px 40px;
  }

  .brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  .logo {
    width: 160px;
    height: auto;
    display: block;
  }

  .brandLine {
    color: #10bb82;
    font-family: 'Poppins', sans-serif;
    font-size: px;
    letter-spacing: .18em;
    text-transform: uppercase;
    font-weight: 300;
  }

  nav {
    padding-top: 8px;
  }

  .nav a {
    color: #ffffff;
    text-decoration: none;
    margin-left: 28px;
    font-size: 11px;
    letter-spacing: .22em;
    text-transform: uppercase;
    opacity: .84;
  }

  .heroText {
  position: relative;
  z-index: 2;
  min-height: calc(100vh - 118px);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 0 7vw 6vh;
  box-sizing: border-box;
  transform: translateY(-28px);
}

  .heroBrand {
    margin: 0 0 12px;
    color: #ffffff;
    font-family: 'Poppins', sans-serif;
    font-size: clamp(22px, 2vw, 34px);
    letter-spacing: .08em;
    text-transform: uppercase;
    font-weight: 400;
  }

  h1 {
    margin: 0;
    color: #ffd3db;
    font-family: Georgia, serif;
    font-size: clamp(50px, 8.2vw, 124px);
    line-height: 0.88;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    color: #ffd3db;
    font-family: Georgia, serif;
    font-size: clamp(48px, 7vw, 96px);
    line-height: .9;
    text-transform: uppercase;
    letter-spacing: -0.035em;
  }

  .positioning {
    margin-top: 22px;
    max-width: 1100px;
    color: #c9a84c;
    font-family: 'Poppins', sans-serif;
    font-size: clamp(12px, 1.25vw, 18px);
    line-height: 1.5;
    letter-spacing: .12em;
    text-transform: uppercase;
    font-weight: 300;
  }

  .story {
    background: #0a0a0a;
    padding: 90px 7vw 120px;
    border-top: 1px solid rgba(255, 211, 219, .28);
  }

  .storyNav {
    display: flex;
    align-items: baseline;
    gap: 18px;
    margin-bottom: 38px;
  }

  .storyTitleMark {
    color: #c9a84c;
    font-family: 'Poppins', sans-serif;
    font-size: 11px;
    letter-spacing: .24em;
    text-transform: uppercase;
  }

  .storyIntro {
    max-width: 820px;
    margin-bottom: 46px;
  }

  .storyIntro p {
    color: #f2f1eb;
    font-family: 'Poppins', sans-serif;
    font-size: clamp(15px, 1.45vw, 22px);
    line-height: 1.55;
    letter-spacing: .02em;
    font-weight: 300;
    margin: 0 0 18px;
  }

  .storyFilmWrap {
    width: 100%;
  }

  .storyFilm {
    width: 100%;
    display: block;
    background: #000;
    border: 1px solid rgba(201,168,76,.35);
  }

  @media (max-width: 900px) {
    nav {
      display: none;
    }

    .logo {
      width: 110px;
    }

    .brandLine {
      font-size: 10px;
    }

    .heroText {
      padding: 0 24px 44px;
    }

    .story {
      padding: 70px 24px;
    }

    .storyIntro p {
      font-size: 17px;
    }
  }
    .society {
    min-height: 100vh;
    box-sizing: border-box;
    background:
      radial-gradient(circle at 72% 45%, rgba(201,168,76,.14), transparent 34%),
      radial-gradient(circle at 50% 62%, rgba(255,211,219,.07), transparent 38%),
      radial-gradient(circle at 25% 35%, rgba(16,187,130,.08), transparent 32%),
      #06100f;
    padding: 56px 7vw 34px;
    border-top: 1px solid rgba(201,168,76,.32);
    overflow: hidden;
  }

  .societyNav {
    display: flex;
    align-items: baseline;
    gap: 18px;
    margin-bottom: 24px;
  }

  .societyTitleMark {
    color: #c9a84c;
    font-family: 'Poppins', sans-serif;
    font-size: 11px;
    letter-spacing: .24em;
    text-transform: uppercase;
  }

  .societyThesis {
    margin-bottom: 20px;
    max-width: 1020px;
  }

  .societyKicker {
  margin: 0 0 6px;
  color: #c9a84c;
  font-family: Georgia, serif;
  font-size: clamp(18px, 1.8vw, 28px);
  line-height: 1;
  letter-spacing: 0.02em;
  text-transform: uppercase;
}

  .societySubhead {
    margin: 0;
    color: #ffd3db;
    font-family: Georgia, serif;
    font-size: clamp(18px, 1.8vw, 28px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .societyStage {
    display: grid;
    grid-template-columns: .38fr 1.62fr;
    gap: 28px;
    align-items: center;
  }

  .societyCopy {
  max-width: 430px;
  align-self: center;
  margin-top: -80px;
}

  .societyCopy p {
    color: #f2f1eb;
    font-family: 'Poppins', sans-serif;
    font-size: clamp(13px, .95vw, 15px);
    line-height: 1.7;
    font-weight: 300;
    margin: 0;
  }

  .networkWrap {
  width: 118%;
  height: min(66vh, 690px);
  min-height: 520px;
  margin-top: -46px;
  margin-left: -8%;
}

  .network {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
    filter: drop-shadow(0 0 22px rgba(201,168,76,.18));
  }

  .networkAura {
    fill: url(#societyAura);
  }

  .networkLines path {
    fill: none;
    stroke: rgba(242,241,235,.3);
    stroke-width: 1;
    stroke-dasharray: 5 9;
    animation: societyLineDrift 9s linear infinite;
  }

  .dataPackets circle {
    fill: #fff3bd;
    filter: drop-shadow(0 0 8px rgba(201,168,76,.95));
  }

  .nodes circle {
    fill: #fff7e6;
    filter:
      drop-shadow(0 0 8px rgba(255,247,230,.9))
      drop-shadow(0 0 18px rgba(201,168,76,.65));
    transform-origin: center;
    animation: societyPulseNode 3.2s ease-in-out infinite;
  }

  .nodes circle:nth-child(2n) {
    animation-delay: .55s;
  }

  .nodes circle:nth-child(3n) {
    animation-delay: 1.1s;
  }

  .centreText {
    filter: drop-shadow(0 0 10px rgba(255,211,219,.28));
  }

  .networkCentre {
    fill: #f2f1eb;
    font-family: Georgia, serif;
    font-size: 25px;
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  .networkCentre.large {
    fill: #ffd3db;
    font-size: 43px;
  }

  .networkLabel {
    fill: #ffd3db;
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .societyBottomStatement {
  margin-top: 12px;
  padding-top: 16px;
  border-top: 1px solid rgba(201,168,76,.28);
  color: #10bb82;
  font-family: 'Poppins', sans-serif;
  font-size: clamp(18px, 1.6vw, 26px);
  line-height: 1.8;
  letter-spacing: .12em;
  text-align: center;
  text-transform: uppercase;
  font-weight: 300;
}

  @keyframes societyPulseNode {
    0%, 100% {
      opacity: .72;
      transform: scale(1);
    }

    50% {
      opacity: 1;
      transform: scale(1.42);
    }
  }

  @keyframes societyLineDrift {
    from {
      stroke-dashoffset: 0;
    }

    to {
      stroke-dashoffset: -80;
    }
  }

  @media (max-width: 900px) {
    .society {
      padding: 70px 24px;
    }

    .societyStage {
      grid-template-columns: 1fr;
    }

    .networkWrap {
      height: 560px;
      margin-top: 0;
    }

    .networkLabel {
      font-size: 10px;
    }

    .networkCentre {
      font-size: 18px;
    }

    .networkCentre.large {
      font-size: 30px;
    }
  }
     .solutions {
    background:
      radial-gradient(circle at 72% 38%, rgba(201,168,76,.08), transparent 34%),
      radial-gradient(circle at 32% 72%, rgba(16,187,130,.06), transparent 36%),
      #0a0a0a;
    padding: 72px 7vw 78px;
    border-top: 1px solid rgba(255, 211, 219, .28);
  }

  .solutionsNav {
    display: flex;
    align-items: baseline;
    gap: 18px;
    margin-bottom: 38px;
  }

  .solutionsTitleMark {
    color: #c9a84c;
    font-family: 'Poppins', sans-serif;
    font-size: 11px;
    letter-spacing: .24em;
    text-transform: uppercase;
  }

  .solutionsIntro {
    max-width: 980px;
    margin-bottom: 52px;
  }

  .solutionsKicker {
    margin: 0 0 12px;
    color: #c9a84c;
    font-family: Georgia, serif;
    font-size: clamp(26px, 2.55vw, 42px);
    line-height: 1.02;
    text-transform: uppercase;
    letter-spacing: -.02em;
  }

  .solutionsSubhead {
    margin: 0;
    color: #ffd3db;
    font-family: 'Poppins', sans-serif;
    font-size: clamp(13px, 1.25vw, 19px);
    letter-spacing: .14em;
    line-height: 1.5;
    text-transform: uppercase;
    font-weight: 300;
  }

    .sixPSystem {
    margin: 36px 0 44px;
  }

  .sixPTop {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 14px;
  }

  .pModule {
    position: relative;
    min-height: 118px;
    padding: 18px 14px;
    border: 1px solid rgba(242,241,235,.16);
    background: rgba(255,255,255,.012);
  }

  .pModule:not(:last-child)::after {
    content: "";
    position: absolute;
    right: -16px;
    top: 50%;
    width: 22px;
    height: 1px;
